model fo_application_logs {
  id              Int                         @id @default(autoincrement()) @db.UnsignedInt
  taken_by_id     Int?                        @db.UnsignedInt
  rel_object_id   Int                         @default(0)
  object_name     String?                     @db.Text
  created_on      DateTime                    @default(dbgenerated("'0000-00-00 00:00:00'")) @db.DateTime(0)
  created_by_id   Int?                        @db.UnsignedInt
  action          fo_application_logs_action?
  is_private      Int                         @default(0) @db.UnsignedTinyInt
  is_silent       Int                         @default(0) @db.UnsignedTinyInt
  log_data        String?                     @db.Text
  member_id       Int                         @default(0)
  full_request    String?                     @db.Text
  request_channel String?                     @default("") @db.VarChar(511)
  is_mail_rule    Boolean?                    @default(false)

  @@index([created_on, action, created_by_id, is_silent], map: "created_on_action_created_by_id_is_silent")
  @@index([member_id, is_silent], map: "member_id")
  @@index([rel_object_id, created_on, is_silent], map: "object")
}

