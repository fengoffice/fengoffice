generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model fo_actual_expense_tax_values {
  tax_id        Int
  object_id     Int
  applied_value Decimal @default(0.000) @db.Decimal(20, 3)
  value         Decimal @default(0.000) @db.Decimal(20, 3)

  @@id([tax_id, object_id])
  @@index([object_id], map: "object_id")
}

model fo_actual_expense_taxes {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(255)
  value             Decimal  @default(0.000) @db.Decimal(20, 3)
  is_percentage     Boolean
  valid_from        DateTime @db.DateTime(0)
  valid_to          DateTime @db.DateTime(0)
  currency_id       Int      @default(0)
  select_by_default Boolean
}

